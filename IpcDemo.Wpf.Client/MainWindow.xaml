<Window x:Class="IpcDemo.Wpf.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Liftoff IPC · Client Workbench" Width="1280" Height="820"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackgroundBrush}">
    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="LIFTOFF / CLIENT WORKBENCH" Style="{StaticResource Eyebrow}"/>
                <TextBlock Text="Send work. Watch the wire." FontSize="30" FontWeight="SemiBold" Margin="0,4,0,0"/>
                <TextBlock Text="A visual trace of one typed request moving through a named-pipe session." Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Text="SERVER THEME" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <CheckBox IsChecked="{Binding Theme.IsDark}" IsHitTestVisible="False" Focusable="False" ToolTip="Theme is controlled by the server"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Ellipse Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource DangerBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                </Ellipse>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding ConnectionLabel}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding HeartbeatLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
                </StackPanel>
                <TextBox Grid.Column="2" Text="{Binding PipeName, UpdateSourceTrigger=PropertyChanged}" Width="210" Margin="12,0" ToolTip="Named pipe"/>
                <Button Grid.Column="3" Content="Connect" Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                <Button Grid.Column="4" Content="Disconnect" Command="{Binding DisconnectCommand}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="REQUEST BUILDER" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="Analyze a model" FontSize="21" FontWeight="SemiBold" Margin="0,3,0,18"/>
                        <TextBlock Text="MODEL NAME" Style="{StaticResource Eyebrow}"/>
                        <TextBox Text="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="BATCHES · 1—100" Style="{StaticResource Eyebrow}"/><TextBox Text="{Binding Steps, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="DELAY · MILLISECONDS" Style="{StaticResource Eyebrow}"/><TextBox Text="{Binding DelayMilliseconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel>
                        </Grid>
                        <CheckBox Content="Ask the remote handler to fail" IsChecked="{Binding ShouldFail}" Margin="0,16"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="IIpcRequest&lt;AnalyzeModelResult&gt;" FontFamily="Cascadia Mono" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Content="Send request" Command="{Binding SendCommand}" Style="{StaticResource PrimaryButton}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid><TextBlock Text="RESPONSE" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding ProgressPercent, StringFormat={}{0:0}%}" HorizontalAlignment="Right" FontFamily="Cascadia Mono" Foreground="{DynamicResource AccentBrush}"/></Grid>
                        <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="7" Margin="0,12,0,16" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource PanelAltBrush}"/>
                        <TextBlock Text="{Binding ResultHeadline}" FontSize="25" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ResultDetail}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,14"/>
                        <Border Background="{DynamicResource PanelAltBrush}" CornerRadius="8" Padding="12"><TextBlock Text="{Binding ProgressMessage}" FontFamily="Cascadia Mono" FontSize="12" TextWrapping="Wrap"/></Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel><TextBlock Text="WIRE ACTIVITY" Style="{StaticResource Eyebrow}"/><TextBlock Text="Session tape" FontSize="21" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Toggle event stream" Command="{Binding ToggleSubscriptionCommand}" Margin="0,0,8,0"/><Button Content="Clear" Command="{Binding ClearActivityCommand}"/></StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="12" Margin="0,16,0,12">
                        <Grid><TextBlock Text="MODELCHANGED EVENTS" Style="{StaticResource Eyebrow}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="{Binding IsSubscribed, StringFormat=Subscribed: {0}}" FontFamily="Cascadia Mono" FontSize="11" Margin="0,0,14,0"/><TextBlock Text="{Binding Events.Count, StringFormat={}{0} received}" FontFamily="Cascadia Mono" FontSize="11"/></StackPanel></Grid>
                    </Border>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Activity}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition Width="74"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" FontFamily="Cascadia Mono" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"/>
                                    <Border Grid.Column="1" Background="{DynamicResource PanelAltBrush}" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock Text="{Binding Kind}" Style="{StaticResource Eyebrow}"/></Border>
                                    <StackPanel Grid.Column="2"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"/></StackPanel>
                                </Grid>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
