<Window x:Class="IpcDemo.Wpf.Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Liftoff IPC · Server Station" Width="1180" Height="780" WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackgroundBrush}">
    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="LIFTOFF / SERVER STATION" Style="{StaticResource Eyebrow}"/><TextBlock Text="Hold the line. Handle the work." FontSize="30" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="See requests arrive, progress leave, and events fan out to subscribers." Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><TextBlock Text="DARK" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,8,0"/><CheckBox IsChecked="{Binding Theme.IsDark}"/></StackPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,18">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Ellipse Width="12" Height="12" Margin="0,0,12,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource DangerBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><StackPanel Grid.Column="1"><TextBlock Text="{Binding StationLabel}" FontWeight="Bold"/><TextBlock Text="One named-pipe session at a time" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/></StackPanel>
                <TextBox Grid.Column="2" Text="{Binding PipeName, UpdateSourceTrigger=PropertyChanged}" Width="210" Margin="12,0"/>
                <Button Grid.Column="3" Content="Start listening" Command="{Binding StartCommand}" Margin="0,0,8,0"/>
                <Button Grid.Column="4" Content="Start + launch client" Command="{Binding StartAndLaunchClientCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                <Button Grid.Column="5" Content="Stop" Command="{Binding StopCommand}"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="0.75*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="ACTIVE HANDLER" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding CurrentWork}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,12"/><ProgressBar Value="{Binding CurrentProgress}" Height="7" Maximum="100" Foreground="{DynamicResource WarningBrush}" Background="{DynamicResource PanelAltBrush}"/><TextBlock Text="AnalyzeModelRequest → AnalyzeModelResult" FontFamily="Cascadia Mono" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,12,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="EVENT PUBLISHER" Style="{StaticResource Eyebrow}"/><TextBlock Text="ModelChanged · every second" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,12"/><CheckBox Content="Publish while listening" IsChecked="{Binding PublishEvents}"/><TextBlock Text="Delivery requires an active subscription; a published event with zero subscribers is intentionally dropped." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12"/></StackPanel></Border>
                <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="REQUESTS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding RequestCount}" FontSize="28" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="PUBLISHED" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding EventCount}" FontSize="28" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="DELIVERED" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding DeliveredCount}" FontSize="28" FontWeight="SemiBold"/></StackPanel>
                </Grid></Border>
            </StackPanel>
            <Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,16"><StackPanel><TextBlock Text="SERVER TAPE" Style="{StaticResource Eyebrow}"/><TextBlock Text="What the station sees" FontSize="21" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel><Button Content="Clear" Command="{Binding ClearActivityCommand}" HorizontalAlignment="Right"/></Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Activity}"><ItemsControl.ItemTemplate><DataTemplate>
                    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition Width="80"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Time}" FontFamily="Cascadia Mono" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"/>
                        <Border Grid.Column="1" Background="{DynamicResource PanelAltBrush}" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock Text="{Binding Kind}" Style="{StaticResource Eyebrow}"/></Border>
                        <StackPanel Grid.Column="2"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel>
                    </Grid>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
            </Grid></Border>
        </Grid>
    </Grid>
</Window>
